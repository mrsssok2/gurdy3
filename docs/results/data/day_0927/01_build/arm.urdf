      <inertia ixx="3e-06" ixy="0" ixz="0" iyy="7.35e-05" iyz="0" izz="7.35e-05"/>
    </inertial>
  </link>
  <!-- Massless foot frame at the foot centre (for IK, contact checks, TF). -->
  <joint name="rr_foot_joint" type="fixed">
    <parent link="rr_tibia"/>
    <child link="rr_foot"/>
    <origin xyz="0.12 0 0"/>
  </joint>
  <link name="rr_foot"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0.17 0" xyz="0.15 0.0 0.02"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="-0.01 0 0"/>
      <geometry>
        <box size="0.02 0.08 0.025"/>
      </geometry>
      <material name="foot_black"/>
    </visual>
  </link>
  <!-- ROS optical convention: z forward, x right, y down -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.05"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.025"/>
      </geometry>
      <material name="foot_black"/>
    </visual>
  </link>
  <ros2_control name="GazeboSimSystem" type="system">
