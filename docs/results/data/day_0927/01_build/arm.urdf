  <!-- second ros2_control hardware block (gz_ros2_control loads every <ros2_control> tag: TO VERIFY in Gazebo) -->
  <ros2_control name="GurdyArmSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="arm_yaw">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_shoulder">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">2.475</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_elbow">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.225</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_wrist_pitch">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.725</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_finger_left_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_finger_right_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="rgbd_camera">
      <gz_frame_id>wrist_camera_optical_frame</gz_frame_id>
      <topic>/wrist_camera</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <triggered>true</triggered>
      <trigger_topic>/wrist_camera/trigger</trigger_topic>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.07</near>
          <far>1.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.07</near>
            <far>1.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.002</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
</robot>
