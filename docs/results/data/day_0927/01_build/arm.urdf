    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters></parameters>
    </plugin>
  </gazebo>
  <gazebo reference="lf_tibia">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="lm_tibia">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="lr_tibia">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rf_tibia">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rm_tibia">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rr_tibia">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <!-- Sensor systems are loaded with the robot, so sensors:=false means no rendering at all
         (the render engine in the world file cost ~60 % RTF even without cameras). -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.005</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.005</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.005</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <!-- gz cameras look along +x of camera_link; ROS image frame = optical frame -->
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/camera</topic>
      <!-- -> /camera/image, /camera/depth_image, /camera/points, /camera/camera_info -->
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <!-- Ground-truth odometry for MEASURING (velocity tracking). No TF: Nav2 will use real odometry. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
      <odom_topic>/model/gurdy/odometry</odom_topic>
      <tf_topic>/model/gurdy/odometry/tf</tf_topic>
    </plugin>
  </gazebo>
  <material name="arm_white">
    <color rgba="0.85 0.85 0.85 1"/>
  </material>
  <material name="arm_dark">
    <color rgba="0.12 0.12 0.14 1"/>
  </material>
  <!-- mount: yaw-servo body fixed on the body top (rear), turned 180 deg -->
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount_link"/>
    <origin rpy="0 0 3.141593" xyz="-0.1 0.0 0.03"/>
  </joint>
