      <mass value="0.014"/>
      <inertia ixx="1.7791666666666669e-06" ixy="0" ixz="0" iyy="2.595833333333334e-06" iyz="0" izz="2.916666666666667e-06"/>
    </inertial>
  </link>
  <joint name="arm_yaw" type="revolute">
