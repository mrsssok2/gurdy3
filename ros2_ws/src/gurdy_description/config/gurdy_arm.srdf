<?xml version="1.0"?>
<!-- Phase 9a DRAFT SRDF for MoveIt 2 (hand-written from the design; regenerate the disable-collision list with
     moveit_setup_assistant on the expanded URDF before use). Not loaded by anything yet.
     Named states = config/arm.yaml poses (folded, ready). -->
<robot name="gurdy">
  <group name="arm">
    <chain base_link="arm_mount_link" tip_link="arm_grasp_link"/>
  </group>
  <group name="gripper">
    <joint name="arm_finger_left_joint"/>
    <joint name="arm_finger_right_joint"/>
  </group>

  <group_state name="folded" group="arm">
    <joint name="arm_yaw" value="0.0"/>
    <joint name="arm_shoulder" value="2.475"/>
    <joint name="arm_elbow" value="0.225"/>
    <joint name="arm_wrist_pitch" value="1.725"/>
    <joint name="arm_wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="arm_yaw" value="0.0"/>
    <joint name="arm_shoulder" value="1.2"/>
    <joint name="arm_elbow" value="-1.6"/>
    <joint name="arm_wrist_pitch" value="-1.0"/>
    <joint name="arm_wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="arm_finger_left_joint" value="0.04"/>
    <joint name="arm_finger_right_joint" value="0.04"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="arm_finger_left_joint" value="0.0"/>
    <joint name="arm_finger_right_joint" value="0.0"/>
  </group_state>

  <end_effector name="gripper" parent_link="arm_palm_link" group="gripper" parent_group="arm"/>

  <!-- the hexapod base is NOT a planning joint: the robot stands still while the arm moves (virtual joint fixed) -->
  <virtual_joint name="world_to_base" type="fixed" parent_frame="odom" child_link="base_link"/>

  <!-- adjacent / always-touching pairs (draft) -->
  <disable_collisions link1="body_link" link2="arm_mount_link" reason="Adjacent"/>
  <disable_collisions link1="arm_mount_link" link2="arm_turret_link" reason="Adjacent"/>
  <disable_collisions link1="arm_turret_link" link2="arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_upper_arm_link" link2="arm_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_forearm_link" link2="arm_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_link" link2="arm_palm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_palm_link" link2="arm_finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="arm_palm_link" link2="arm_finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="arm_finger_left_link" link2="arm_finger_right_link" reason="Default"/>
  <disable_collisions link1="body_link" link2="arm_turret_link" reason="Never"/>
  <!-- legs (lf..rr coxa/femur/tibia) vs arm links stay ENABLED: the arm must never touch a leg -->
</robot>
