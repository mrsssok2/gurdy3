  <group_state name="folded" group="arm"><joint name="arm_yaw" value="0.0"/><joint name="arm_shoulder" value="2.475"/><joint name="arm_elbow" value="0.225"/><joint name="arm_wrist_pitch" value="1.725"/><joint name="arm_wrist_roll" value="0.0"/></group_state>
  <group_state name="ready" group="arm"><joint name="arm_yaw" value="0.0"/><joint name="arm_shoulder" value="1.2"/><joint name="arm_elbow" value="-1.6"/><joint name="arm_wrist_pitch" value="-1.0"/><joint name="arm_wrist_roll" value="0.0"/></group_state>
  <group_state name="servo_view" group="arm"><joint name="arm_yaw" value="0.0"/><joint name="arm_shoulder" value="1.95"/><joint name="arm_elbow" value="-1.95"/><joint name="arm_wrist_pitch" value="-1.15"/><joint name="arm_wrist_roll" value="0.0"/></group_state>
  <group_state name="servo_view_far" group="arm"><joint name="arm_yaw" value="0.0"/><joint name="arm_shoulder" value="1.8"/><joint name="arm_elbow" value="-1.625"/><joint name="arm_wrist_pitch" value="-1.15"/><joint name="arm_wrist_roll" value="0.0"/></group_state>
  <group_state name="pre_grasp" group="arm"><joint name="arm_yaw" value="0.0"/><joint name="arm_shoulder" value="1.2"/><joint name="arm_elbow" value="-1.6"/><joint name="arm_wrist_pitch" value="-1.0"/><joint name="arm_wrist_roll" value="0.0"/></group_state>  <!-- placeholder: the real pre-grasp is computed per object (gurdy_core.arm.plan_grasp) -->
